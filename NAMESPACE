# Hand-written on purpose: there is no roxygen step to remember. Every
# function whose name does not begin with a dot is exported automatically,
# so adding a function to R/ is all a workstream needs to do.

exportPattern("^[^.]")

S3method(print, design_cell)
S3method(print, sim_dataset)
S3method(print, fit_result)

